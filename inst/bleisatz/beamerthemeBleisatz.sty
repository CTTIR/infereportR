%% =====================================================================
%%  beamerthemeBleisatz.sty
%%  Bleisatz — a strictly 1-bit Beamer theme: #000000 ink on #FFFFFF paper.
%%  No greys, no tints, no transparency, no rounded corners, no shadows.
%%  Emphasis is carried by weight, size, position, inversion and pattern.
%%
%%  Version 1.3 (2026-11-19) · LPPL 1.3c
%%  Engines: pdfLaTeX (Overleaf default), LuaLaTeX, XeLaTeX
%%  Typeface: IBM Plex Sans / Sans Condensed / Mono (SIL OFL, in TeX Live);
%%            optionally C64 Pro Mono (font=c64, see below)
%%
%%  Theme options
%%  Without options: Bleisatz 1-bit, light, IBM Plex, progress bar.
%%
%%    total           folio shows "7 / 24" instead of "7"
%%    nohead          no running head on content frames
%%    nosectionpages  no automatic contents divider at \section
%%    dark            the whole deck white on black (inverse frames turn black on white)
%%    progress=bar    the head rule is a progress bar with a dot per section (default)
%%    progress=dots   one dot per frame beside the folio, grouped by section
%%    progress=none   the plain head rule
%%    font=plex       IBM Plex Sans, Sans Condensed and Mono (default)
%%    font=mono       IBM Plex Mono throughout (every engine, TeX Live fonts)
%%    font=c64        C64 Pro Mono throughout, on square cells one em wide
%%                    (LuaLaTeX; the font is not part of this theme, get it from
%%                    https://style64.org/c64-truetype; without it: font=mono)
%%    font=etbb       ET Book (ETbb, in TeX Live), Edward Tufte's typeface
%%
%%  Tufte (Cognitive Style of PowerPoint, Visual Display, Beautiful Evidence):
%%  every aspect is an option of its own, Bleisatz value first (the default).
%%    palette=onebit|grey|tufte  two values | plus one grey (#999999) for
%%                    context, sources, markers | plus the grey, Tufte's red and green
%%    onebit, grey    short for palette=onebit, palette=grey
%%    font=etbb       ET Book (see above)
%%    rules=heavy|hair         heavy head, block and title rules | hairlines only
%%    typography=bleisatz|tufte  weight for structure | italic and size, regular
%%                    titles, grey markers and sources, no section numbers
%%    emphasis=inverse|italic  \inv, \alert, alertblock and inverse frames
%%                    reversed | italic, hairlines, no reversed type
%%    figures=bleisatz|tufte   \figurefolder searches the Bleisatz folders first |
%%                    the Tufte set first; pgfplots in Tufte's style
%%    head|nohead, sectionpages|nosectionpages, progress=...  (see above)
%%    tufte           all of them at once: palette=tufte, font=etbb, rules=hair,
%%                    typography=tufte, emphasis=italic, figures=tufte, nohead,
%%                    progress=none, nosectionpages. Any option given beside it
%%                    wins (tufte,head,progress=bar,font=plex,onebit ...).
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeBleisatz}
  [2026/11/19 v1.3 Bleisatz: strictly black-and-white Beamer theme]

\RequirePackage{iftex}
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\usetikzlibrary{patterns,calc}
\RequirePackage{booktabs}
\RequirePackage{ragged2e}
\RequirePackage[absolute,overlay]{textpos}

%% ---------------------------------------------------------------------
%%  Options
%% ---------------------------------------------------------------------
\newif\ifbz@total        \bz@totalfalse
\newif\ifbz@head         \bz@headtrue
\newif\ifbz@sectionpages \bz@sectionpagestrue
\newif\ifbz@dark         \bz@darkfalse
\newif\ifbz@tufte        \bz@tuftefalse
% which options were given explicitly (they win over the tufte defaults)
\newif\ifbz@headset      \newif\ifbz@secpagesset
\newif\ifbz@progressset  \newif\ifbz@fontset
\DeclareOptionBeamer{total}{\bz@totaltrue}
\DeclareOptionBeamer{nohead}{\bz@headfalse\bz@headsettrue}
\DeclareOptionBeamer{head}{\bz@headtrue\bz@headsettrue}
\DeclareOptionBeamer{nosectionpages}{\bz@sectionpagesfalse\bz@secpagessettrue}
\DeclareOptionBeamer{sectionpages}{\bz@sectionpagestrue\bz@secpagessettrue}
\DeclareOptionBeamer{dark}{\bz@darktrue}
\DeclareOptionBeamer{tufte}{\bz@tuftetrue}
% palette=onebit | grey | tufte (default onebit; with tufte: tufte)
\def\bz@palette{}
\DeclareOptionBeamer{palette}{\edef\bz@palette{#1}}
\DeclareOptionBeamer{onebit}{\def\bz@palette{onebit}}
\DeclareOptionBeamer{grey}{\def\bz@palette{grey}}
% progress=bar | dots | none (default bar; with tufte: none; "progress" alone means bar)
\def\bz@progress{bar}
\DeclareOptionBeamer{progress}[bar]{\edef\bz@progress{#1}\bz@progresssettrue}
% font=plex | mono | c64 | etbb (default plex; with tufte: etbb)
\def\bz@font{plex}
\DeclareOptionBeamer{font}{\edef\bz@font{#1}\bz@fontsettrue}
% the Tufte aspects, one option each (empty = not given: Bleisatz, or Tufte under tufte)
\def\bz@rules{}\def\bz@typography{}\def\bz@emphasis{}\def\bz@figures{}
\DeclareOptionBeamer{rules}{\edef\bz@rules{#1}}
\DeclareOptionBeamer{typography}{\edef\bz@typography{#1}}
\DeclareOptionBeamer{emphasis}{\edef\bz@emphasis{#1}}
\DeclareOptionBeamer{figures}{\edef\bz@figures{#1}}
\ProcessOptionsBeamer
\def\bz@str@bar{bar}\def\bz@str@dots{dots}\def\bz@str@none{none}
\ifx\bz@progress\bz@str@bar\else\ifx\bz@progress\bz@str@dots\else\ifx\bz@progress\bz@str@none\else
  \PackageWarning{beamerthemeBleisatz}{Unknown value progress=\bz@progress; using none}%
  \def\bz@progress{none}%
\fi\fi\fi
\def\bz@str@plex{plex}\def\bz@str@mono{mono}\def\bz@str@csf{c64}\def\bz@str@etbb{etbb}
% tufte: Tufte's defaults wherever no option said otherwise
\ifbz@tufte
  \ifx\bz@palette\@empty\def\bz@palette{tufte}\fi
  \ifbz@fontset\else\def\bz@font{etbb}\fi
  \ifbz@secpagesset\else\bz@sectionpagesfalse\fi
  \ifbz@progressset\else\def\bz@progress{none}\fi
  \ifbz@headset\else
    \ifx\bz@progress\bz@str@none\bz@headfalse\fi   % an explicit progress keeps the head
  \fi
\else
  \ifx\bz@palette\@empty\def\bz@palette{onebit}\fi
\fi
% one flag per aspect: true = Tufte's way
\newif\ifbz@hair \newif\ifbz@ttype \newif\ifbz@italic \newif\ifbz@tfigs
\def\bz@aspect#1#2#3#4{% value macro, Bleisatz value, Tufte value, flag name
  \ifx#1\@empty\ifbz@tufte\def#1{#3}\else\def#1{#2}\fi\fi
  \def\bz@tmp{#3}\ifx#1\bz@tmp\csname bz@#4true\endcsname\else
  \def\bz@tmp{#2}\ifx#1\bz@tmp\else
    \PackageWarning{beamerthemeBleisatz}{Unknown value \detokenize\expandafter{#1}; using #2}%
    \def#1{#2}\fi\fi}
\bz@aspect\bz@rules{heavy}{hair}{hair}
\bz@aspect\bz@typography{bleisatz}{tufte}{ttype}
\bz@aspect\bz@emphasis{inverse}{italic}{italic}
\bz@aspect\bz@figures{bleisatz}{tufte}{tfigs}
\ifx\bz@font\bz@str@plex\else\ifx\bz@font\bz@str@mono\else\ifx\bz@font\bz@str@csf\else
\ifx\bz@font\bz@str@etbb\else
  \PackageWarning{beamerthemeBleisatz}{Unknown value font=\bz@font; using plex}%
  \def\bz@font{plex}%
\fi\fi\fi\fi
\def\bz@str@onebit{onebit}\def\bz@str@grey{grey}\def\bz@str@tpal{tufte}
\newif\ifbz@grey   \bz@greyfalse    % the one grey is allowed
\newif\ifbz@colour \bz@colourfalse  % Tufte's red and green are allowed
\ifx\bz@palette\bz@str@tpal\bz@greytrue\bz@colourtrue\else
\ifx\bz@palette\bz@str@grey\bz@greytrue\else
\ifx\bz@palette\bz@str@onebit\else
  \PackageWarning{beamerthemeBleisatz}{Unknown value palette=\bz@palette; using onebit}%
  \def\bz@palette{onebit}%
\fi\fi\fi

%% ---------------------------------------------------------------------
%%  Grid
%%  16:9 page = 160 x 90 mm. One outer margin, one rule weight family.
%% ---------------------------------------------------------------------
\newlength\bz@margin      \setlength\bz@margin{13mm}
\newlength\bz@heavy       \setlength\bz@heavy{1.1pt}   % head rule, block rule
\newlength\bz@hair        \setlength\bz@hair{0.4pt}    % everything else
\newlength\bz@fill        \setlength\bz@fill{1.1pt}    % progress bar fill
% tufte: the smallest effective difference; no heavy rules anywhere
\ifbz@hair\setlength\bz@heavy{\bz@hair}\fi
\newlength\bz@titleheight \setlength\bz@titleheight{37pt} % 2 title lines
\newlength\bz@measure     % comfortable line length for running text
\setbeamersize{text margin left=\bz@margin, text margin right=\bz@margin}
\TPGrid[0mm,0mm]{160}{90}% textpos unit = 1 mm on a 16:9 page

% top-aligned frames by default: the grid only works if content
% always starts at the same height
\beamer@centeredfalse

%% ---------------------------------------------------------------------
%%  Colour: exactly two values
%% ---------------------------------------------------------------------
% Dark decks swap the two values themselves, so every rule, pattern and pgfplots
% style follows without further changes.
\ifbz@dark
  \definecolor{bzink}{RGB}{255,255,255}
  \definecolor{bzpaper}{RGB}{0,0,0}
\else
  \definecolor{bzink}{RGB}{0,0,0}
  \definecolor{bzpaper}{RGB}{255,255,255}
\fi
\def\bz@ink{bzink}
\def\bz@paper{bzpaper}
% The palette beyond the two values: one grey (palette=grey|tufte), Tufte's
% red and green (palette=tufte). Where the palette lacks them they are ink,
% so a deck never shows a colour it was not allowed. C64: VIC-II colours.
\ifbz@grey
  \ifx\bz@font\bz@str@csf\definecolor{bzgrey}{RGB}{149,149,149}%
  \else\definecolor{bzgrey}{RGB}{153,153,153}\fi
\else\colorlet{bzgrey}{bzink}\fi
\ifbz@colour
  \ifx\bz@font\bz@str@csf
    \ifbz@dark\definecolor{bzred}{RGB}{203,126,117}\definecolor{bzgreen}{RGB}{154,226,155}%
    \else\definecolor{bzred}{RGB}{159,78,68}\definecolor{bzgreen}{RGB}{92,171,94}\fi
  \else
    \ifbz@dark\definecolor{bzred}{RGB}{229,72,77}\definecolor{bzgreen}{RGB}{93,183,96}%
    \else\definecolor{bzred}{RGB}{179,32,42}\definecolor{bzgreen}{RGB}{46,125,50}\fi
  \fi
\else\colorlet{bzred}{bzink}\colorlet{bzgreen}{bzink}\fi
% \muted{} context and sources (grey); \inred{} / \ingreen{} link numbers to
% the marks of the same colour (palette=tufte; otherwise italic / plain ink)
\DeclareRobustCommand\muted[1]{{\color{bzgrey}#1}}
\DeclareRobustCommand\inred[1]{{\ifbz@colour\color{bzred}#1\else\itshape#1\fi}}
\DeclareRobustCommand\ingreen[1]{{\ifbz@colour\color{bzgreen}\fi#1}}

\newcommand\bz@applycolors{%
  \edef\bz@tmp{%
    \noexpand\setbeamercolor{normal text}{fg=\bz@ink,bg=\bz@paper}%
    \noexpand\setbeamercolor{background canvas}{bg=\bz@paper}%
    \noexpand\setbeamercolor{structure}{fg=\bz@ink}%
    \noexpand\setbeamercolor{local structure}{fg=\bz@ink}%
    \noexpand\setbeamercolor{item}{fg=\bz@ink}%
    \noexpand\setbeamercolor{subitem}{fg=\bz@ink}%
    \noexpand\setbeamercolor{subsubitem}{fg=\bz@ink}%
    \noexpand\setbeamercolor{item projected}{fg=\bz@paper,bg=\bz@ink}%
    \noexpand\setbeamercolor{alerted text}{fg=\bz@ink}%
    \noexpand\setbeamercolor{example text}{fg=\bz@ink}%
    \noexpand\setbeamercolor{titlelike}{fg=\bz@ink}%
    \noexpand\setbeamercolor{title}{fg=\bz@ink}%
    \noexpand\setbeamercolor{subtitle}{fg=\bz@ink}%
    \noexpand\setbeamercolor{frametitle}{fg=\bz@ink}%
    \noexpand\setbeamercolor{framesubtitle}{fg=\bz@ink}%
    \noexpand\setbeamercolor{block title}{fg=\bz@ink}%
    \noexpand\setbeamercolor{block body}{fg=\bz@ink}%
    \noexpand\setbeamercolor{block title example}{fg=\bz@ink}%
    \noexpand\setbeamercolor{block body example}{fg=\bz@ink}%
    \noexpand\setbeamercolor{caption name}{fg=\bz@ink}%
    \noexpand\setbeamercolor{footnote}{fg=\bz@ink}%
    \noexpand\setbeamercolor{footnote mark}{fg=\bz@ink}%
    \noexpand\setbeamercolor{section in toc}{fg=\bz@ink}%
    \noexpand\setbeamercolor{section in toc shaded}{fg=\bz@ink}%
    \noexpand\setbeamercolor{subsection in toc}{fg=\bz@ink}%
    \noexpand\setbeamercolor{subsection in toc shaded}{fg=\bz@ink}%
    \noexpand\setbeamercolor{palette primary}{fg=\bz@ink,bg=\bz@paper}%
    \noexpand\setbeamercolor{palette secondary}{fg=\bz@ink,bg=\bz@paper}%
    \noexpand\setbeamercolor{palette tertiary}{fg=\bz@ink,bg=\bz@paper}%
    \noexpand\setbeamercolor{palette quaternary}{fg=\bz@ink,bg=\bz@paper}%
    \noexpand\setbeamercolor{button}{fg=\bz@paper,bg=\bz@ink}%
    \noexpand\setbeamercolor{navigation symbols}{fg=\bz@ink}%
    \noexpand\setbeamercolor{navigation symbols dimmed}{fg=\bz@ink}%
    \noexpand\setbeamercolor{bibliography item}{fg=\bz@ink}%
    \noexpand\setbeamercolor{bibliography entry author}{fg=\bz@ink}%
    \noexpand\setbeamercolor{bibliography entry title}{fg=\bz@ink}%
    \noexpand\setbeamercolor{bibliography entry location}{fg=\bz@ink}%
    \noexpand\setbeamercolor{bibliography entry note}{fg=\bz@ink}%
    \noexpand\setbeamercolor{note page}{fg=\bz@ink,bg=\bz@paper}%
    \noexpand\setbeamercolor{note title}{fg=\bz@ink,bg=\bz@paper}%
    \noexpand\setbeamercolor{bz inverse}{fg=\bz@paper,bg=\bz@ink}%
  }\bz@tmp}

% swap ink and paper (used by alert blocks, \inv, inverse frames)
\newcommand\bz@swap{%
  \let\bz@tmpc\bz@ink\let\bz@ink\bz@paper\let\bz@paper\bz@tmpc
  \bz@applycolors}

\bz@applycolors
\setbeamercovered{invisible}% beamer's "transparent" would create grey

%% ---------------------------------------------------------------------
%%  Typefaces
%%  font=plex  pdfLaTeX: Type 1 versions from the "plex" package;
%%             Lua/XeLaTeX: the OpenType files of the same package
%%  font=mono  IBM Plex Mono for every role (Type 1 or OpenType)
%%  font=c64   C64 Pro Mono for every role (LuaLaTeX or XeLaTeX, installed)
%%  Fallbacks: font=c64 -> font=mono (pdfLaTeX, or C64 Pro Mono missing);
%%             Plex missing -> TeX Gyre Heros / Latin Modern Mono
%% ---------------------------------------------------------------------
\ifx\bz@font\bz@str@csf
  \ifPDFTeX
    \PackageWarning{beamerthemeBleisatz}{font=c64 needs LuaLaTeX (or XeLaTeX);
      using font=mono}%
    \def\bz@font{mono}%
  \fi
\fi
\newif\ifbz@plex
\newif\ifbz@etbb
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \ifx\bz@font\bz@str@etbb
    \IfFileExists{ETbb.sty}{\bz@etbbtrue}{%
      \PackageWarning{beamerthemeBleisatz}{ET Book (ETbb) not found; using font=plex}%
      \def\bz@font{plex}}%
  \fi
  \ifbz@etbb
    % ET Book: oldstyle proportional figures in text, lining tabular in
    % tables and key figures; IBM Plex Mono stays the monospaced face
    \RequirePackage[p,osf]{ETbb}
    \renewcommand\sfdefault{ETbb-OsF}
    \IfFileExists{T1plxMono-TLF.fd}{\renewcommand\ttdefault{plxMono-TLF}}{}
    \newcommand\bz@light{\fontfamily{ETbb-OsF}\fontseries{m}\selectfont}
    \newcommand\bz@cond{\fontfamily{ETbb-OsF}\fontseries{m}\selectfont}
    \newcommand\bz@condbf{\fontfamily{ETbb-OsF}\fontseries{m}\fontshape{it}\selectfont}
    \newcommand\bz@tabnums{\fontfamily{ETbb-TLF}\selectfont}
    \newcommand\bz@liningnums{\fontfamily{ETbb-LF}\selectfont}
  \else
  \IfFileExists{T1plxSans-TLF.fd}{\bz@plextrue}{\bz@plexfalse}
  \ifbz@plex
    \ifx\bz@font\bz@str@mono
      \renewcommand\sfdefault{plxMono-TLF}
      \renewcommand\rmdefault{plxMono-TLF}
      \renewcommand\ttdefault{plxMono-TLF}
      \renewcommand\bfdefault{sb}
      \newcommand\bz@light{\fontfamily{plxMono-TLF}\fontseries{l}\selectfont}
      \newcommand\bz@cond{\fontfamily{plxMono-TLF}\fontseries{m}\selectfont}
      \newcommand\bz@condbf{\fontfamily{plxMono-TLF}\fontseries{sb}\selectfont}
    \else
      \renewcommand\sfdefault{plxSans-TLF}
      \renewcommand\rmdefault{plxSerif-TLF}
      \renewcommand\ttdefault{plxMono-TLF}
      \renewcommand\bfdefault{sb}
      \newcommand\bz@light{\fontfamily{plxSans-TLF}\fontseries{l}\selectfont}
      \newcommand\bz@cond{\fontfamily{plxSans-TLF}\fontseries{c}\selectfont}
      \newcommand\bz@condbf{\fontfamily{plxSans-TLF}\fontseries{sbc}\selectfont}
    \fi
  \else
    \PackageWarning{beamerthemeBleisatz}{IBM Plex not found, using TeX Gyre Heros}
    \renewcommand\sfdefault{qhv}
    \renewcommand\ttdefault{lmtt}
    \ifx\bz@font\bz@str@mono\renewcommand\sfdefault{lmtt}\fi
    \newcommand\bz@light{\fontfamily{\sfdefault}\fontseries{m}\selectfont}
    \newcommand\bz@cond{\fontfamily{\sfdefault}\fontseries{m}\selectfont}
    \newcommand\bz@condbf{\fontfamily{\sfdefault}\fontseries{b}\selectfont}
  \fi
  \fi
\else
  \RequirePackage{fontspec}
  % C64 Pro Mono as an installed font, or as the file of the font package in
  % the project folder (Overleaf: upload C64_Pro_Mono-STYLE.ttf next to the .tex)
  \def\bz@csfname{}
  \ifx\bz@font\bz@str@csf
    \IfFontExistsTF{C64 Pro Mono}{\def\bz@csfname{C64 Pro Mono}}{%
      \IfFontExistsTF{C64_Pro_Mono-STYLE.ttf}{\def\bz@csfname{C64_Pro_Mono-STYLE.ttf}}{%
        \IfFontExistsTF{C64_Pro_Mono-STYLE.otf}{\def\bz@csfname{C64_Pro_Mono-STYLE.otf}}{}}}%
    \ifx\bz@csfname\@empty
      \PackageWarning{beamerthemeBleisatz}{C64 Pro Mono is not installed
        (https://style64.org/c64-truetype); using font=mono}%
      \def\bz@font{mono}%
    \fi
  \fi
  \IfFontExistsTF{IBMPlexSans-Regular.otf}{\bz@plextrue}{\bz@plexfalse}
  \ifx\bz@font\bz@str@etbb
    \IfFontExistsTF{ETbb-Regular.otf}{\bz@etbbtrue}{%
      \PackageWarning{beamerthemeBleisatz}{ET Book (ETbb) not found; using font=plex}%
      \def\bz@font{plex}}%
  \fi
  \ifbz@etbb
    \defaultfontfeatures{Ligatures=TeX}
    \setsansfont{ETbb}[Extension=.otf, UprightFont=*-Regular, ItalicFont=*-Italic,
      BoldFont=*-Bold, BoldItalicFont=*-BoldItalic, Numbers={OldStyle,Proportional}]
    \setmainfont{ETbb}[Extension=.otf, UprightFont=*-Regular, ItalicFont=*-Italic,
      BoldFont=*-Bold, BoldItalicFont=*-BoldItalic, Numbers={OldStyle,Proportional}]
    \ifbz@plex
      \setmonofont{IBMPlexMono}[Extension=.otf, UprightFont=*-Regular, ItalicFont=*-Italic,
        BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic]
    \fi
    \newcommand\bz@light{\sffamily}
    \newcommand\bz@cond{\sffamily}
    \newcommand\bz@condbf{\sffamily\itshape}
    \newcommand\bz@tabnums{\addfontfeatures{Numbers={Lining,Monospaced}}}
    \newcommand\bz@liningnums{\addfontfeatures{Numbers={Lining}}}
  \else
  \ifx\bz@font\bz@str@csf
    % One face for every role. C64 Pro Mono has a single weight and no
    % italics, so those shapes point to the same face. TeX ligatures stay off;
    % under LuaLaTeX "--" becomes one hyphen and any glyph the font lacks
    % (umlauts, the section sign) comes from IBM Plex Mono.
    \ifLuaTeX
      \directlua{luaotfload.add_fallback("bleisatzcsixtyfour",
        {"file:IBMPlexMono-Regular.otf:mode=node;"})}%
      % "--" and "---" set as one hyphen: the C64 had no dashes
      \directlua{fonts.handlers.otf.addfeature{name = "bzhyphen", type = "ligature",
        data = {[0x2D] = {0x2D, 0x2D}}}}%
      \def\bz@csffallback{RawFeature={fallback=bleisatzcsixtyfour;+bzhyphen}}%
    \else
      \def\bz@csffallback{}%
      \PackageWarning{beamerthemeBleisatz}{font=c64 under XeLaTeX: glyphs that
        C64 Pro Mono lacks (umlauts, section sign) are dropped; LuaLaTeX fills
        them from IBM Plex Mono}%
    \fi
    \edef\bz@csffeatures{Ligatures=TeXOff, BoldFont={\bz@csfname},
      ItalicFont={\bz@csfname}, BoldItalicFont={\bz@csfname},
      SlantedFont={\bz@csfname}, \bz@csffallback}
    \edef\bz@tmp{%
      \noexpand\setsansfont{\bz@csfname}[\bz@csffeatures]%
      \noexpand\setmainfont{\bz@csfname}[\bz@csffeatures]%
      \noexpand\setmonofont{\bz@csfname}[\bz@csffeatures]%
      \noexpand\newfontfamily\noexpand\bz@light{\bz@csfname}[\bz@csffeatures]}%
    \bz@tmp
    \let\bz@cond\bz@light
    \let\bz@condbf\bz@light
    % What the C64 had no glyph for, written as it would have been typed.
    \RequirePackage{newunicodechar}
    \newunicodechar{≥}{>=}\newunicodechar{≤}{<=}\newunicodechar{±}{+/-}
    \newunicodechar{×}{x}\newunicodechar{−}{-}\newunicodechar{–}{-}
    \newunicodechar{—}{--}\newunicodechar{·}{/}\newunicodechar{…}{...}
    \UndeclareTextCommand{\textendash}{TU}\DeclareTextCommand{\textendash}{TU}{-}
    \UndeclareTextCommand{\textemdash}{TU}\DeclareTextCommand{\textemdash}{TU}{--}
    \UndeclareTextCommand{\textperiodcentered}{TU}\DeclareTextCommand{\textperiodcentered}{TU}{/}
    \UndeclareTextCommand{\textellipsis}{TU}\DeclareTextCommand{\textellipsis}{TU}{...}
    % Math: letters and digits from the same face; relations as typed.
    \edef\bz@tmp{\noexpand\DeclareSymbolFont{bzcsf}{TU}{\sfdefault}{m}{n}}\bz@tmp
    % \bz@mc<class><char>: that character in math from the C64 face
    \def\bz@mc#1#2{\Umathcode`#2="#1 \symbzcsf`#2\relax}
    \AtBeginDocument{%
      \count@=`a \loop\Umathcode\count@="7 \symbzcsf\count@
        \advance\count@\@ne\ifnum\count@<`\{\repeat
      \count@=`A \loop\Umathcode\count@="7 \symbzcsf\count@
        \advance\count@\@ne\ifnum\count@<`\[\repeat
      \count@=`0 \loop\Umathcode\count@="7 \symbzcsf\count@
        \advance\count@\@ne\ifnum\count@<`\:\repeat
      \bz@mc2+\bz@mc2-\bz@mc3=\bz@mc3<\bz@mc3>\bz@mc3:\bz@mc4(\bz@mc4[%
      \bz@mc5)\bz@mc5]\bz@mc6,\bz@mc6;\bz@mc0.\bz@mc0/\bz@mc0|\bz@mc5!\bz@mc5?%
      \renewcommand\geq{\mathrel{\mbox{>=}}}\let\ge\geq
      \renewcommand\leq{\mathrel{\mbox{<=}}}\let\le\leq
      \renewcommand\times{\mathbin{\mbox{x}}}%
      \renewcommand\pm{\mathbin{\mbox{+/-}}}}%
  \else\ifbz@plex
    \defaultfontfeatures{Ligatures=TeX}
    \ifx\bz@font\bz@str@mono
      \setsansfont{IBMPlexMono}[Extension=.otf,
        UprightFont=*-Regular, ItalicFont=*-Italic,
        BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic]
      \setmainfont{IBMPlexMono}[Extension=.otf,
        UprightFont=*-Regular, ItalicFont=*-Italic,
        BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic]
      \setmonofont{IBMPlexMono}[Extension=.otf,
        UprightFont=*-Regular, ItalicFont=*-Italic,
        BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic]
      \newfontfamily\bz@light{IBMPlexMono}[Extension=.otf,
        UprightFont=*-Light, ItalicFont=*-LightItalic,
