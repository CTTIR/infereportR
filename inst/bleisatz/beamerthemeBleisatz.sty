    {\usebeamercolor[fg]{normal text}\usebeamerfont{section in toc}\itshape
     \vskip 0.9mm\hbox to\linewidth{\bz@tocindent\bz@toctext\hss}\vskip 1.2mm}\par
  \else
    {\setlength\fboxsep{0pt}%
     \colorbox{\bz@ink}{\parbox{\linewidth}{%
       \vskip 0.9mm
       \hbox to\linewidth{\hskip 1.8mm{\color{\bz@paper}%
         \usebeamerfont{section in toc}\bz@toctext}\hss}%
       \vskip 1.2mm}}}\par
  \fi}
\setbeamertemplate{section in toc shaded}{%
  {\ifbz@ttype\color{bzgrey}\else\usebeamercolor[fg]{normal text}\fi
