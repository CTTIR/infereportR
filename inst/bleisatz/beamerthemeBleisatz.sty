%% ---------------------------------------------------------------------
%%  Progress (option progress=bar|dots)
%%  bar:  the head rule is the bar. A hairline track runs the full width,
%%        the heavy rule fills it up to the current frame; one dot per
%%        section start, filled once that section has begun.
%%          ━━━━━━━━━●━━━━━━━━━━●━━━━━━━━━○──────────────○─────────
%%  dots: one dot per frame in the head row, left of the folio, grouped
%%        by section; filled up to the current frame.
%%          ●●●●  ●●●●  ●●○○  ○○○○  ○○  7
%%  Both count main frames only (\insertmainframenumber) and step aside
%%  in the appendix. Section starts are written to the .aux file, so
%%  the indicator appears from the second run on.
%% ---------------------------------------------------------------------
\newcount\bz@cur  \newcount\bz@tot  \newcount\bz@i  \newcount\bz@s
\newdimen\bz@x    \newdimen\bz@w    \newdimen\bz@pitch
\newdimen\bz@gap  \newdimen\bz@r    \newdimen\bz@foliow
\def\bz@secmarks{}
\newcommand\bz@addsecmark[1]{\xifinlist{#1}\bz@secmarks{}{\listxadd\bz@secmarks{#1}}}
% Remember where each section starts: the next numbered frame.
\newcommand\bz@marksection{%
  \ifbeamer@inappendix\else\if@filesw
    \immediate\write\@auxout{\string\bz@addsecmark{\the\numexpr\c@framenumber+1\relax}}%
  \fi\fi}
\patchcmd{\beamer@section}{\beamer@sectionstartpage=\c@page}%
  {\bz@marksection\beamer@sectionstartpage=\c@page}{}%
  {\PackageWarning{beamerthemeBleisatz}{Could not record section starts; progress dots off}}
% Keep the .aux readable if the theme is removed later.
\AtBeginDocument{\if@filesw
  \immediate\write\@auxout{\string\providecommand\string\bz@addsecmark[1]{}}\fi}

% \bz@cur = current frame, \bz@tot = main frames; 0 if not known yet
\newcommand\bz@progressvalues{%
  \bz@cur=\c@framenumber
  \bz@tot=\insertmainframenumber\relax
  \ifnum\bz@tot<2 \bz@tot=0 \fi
  \ifnum\bz@cur>\bz@tot \bz@cur=\bz@tot \fi}

% the plain head rule
\newcommand\bz@rule@none{%
  \ifbz@hair
    % rules=hair: a hairline under the running head; none above a title page
    % without head
    \ifbz@head{\color{\bz@ink}\rule{\dimexpr\paperwidth-2\bz@margin\relax}{\bz@hair}}\fi
  \else
    {\color{\bz@ink}\rule{\dimexpr\paperwidth-2\bz@margin\relax}{\bz@heavy}}%
  \fi}

% the head rule as a progress bar
\newcommand\bz@rule@bar{%
  \bz@progressvalues
  \ifnum\bz@tot=0 \bz@rule@none\else
  \bz@w=\dimexpr\paperwidth-2\bz@margin\relax
  \bz@r=0.62mm
  \begin{pgfpicture}%
    \pgfpathrectangle{\pgfpointorigin}{\pgfpoint{\bz@w}{\bz@fill}}%
    \pgfusepath{use as bounding box}%
    \pgfsetfillcolor{\bz@ink}%
    % track: hairline, centred on the fill
    \pgfpathrectangle{\pgfpoint{0pt}{\dimexpr(\bz@fill-\bz@hair)/2\relax}}{\pgfpoint{\bz@w}{\bz@hair}}%
    \pgfusepath{fill}%
    % fill: the heavy rule up to the current frame
    \bz@x=\dimexpr\bz@w*\bz@cur/\bz@tot\relax
    \pgfpathrectangle{\pgfpointorigin}{\pgfpoint{\bz@x}{\bz@fill}}%
    \pgfusepath{fill}%
    % one dot per section start
    \pgfsetlinewidth{\bz@hair}%
    \pgfsetstrokecolor{\bz@ink}%
    \forlistloop\bz@secdot\bz@secmarks
  \end{pgfpicture}%
  \fi}
\newcommand\bz@secdot[1]{%
  \bz@s=#1\relax
  \ifnum\bz@s>\bz@tot\else
    \bz@x=\dimexpr\bz@w*(\bz@s-1)/\bz@tot\relax
    \begin{pgfscope}%
      % open (paper inside, hairline ring) until the section has begun
      \ifnum\bz@cur<\bz@s \pgfsetfillcolor{\bz@paper}\fi
      \pgfpathcircle{\pgfpoint{\bz@x}{\dimexpr\bz@fill/2\relax}}{\bz@r}%
      \ifnum\bz@cur<\bz@s \pgfusepath{fill,stroke}\else\pgfusepath{fill}\fi
    \end{pgfscope}%
  \fi}

% one dot per frame, for the head row
\newcommand\bz@countgap[1]{\ifnum#1>1 \ifnum#1>\bz@tot\else\advance\bz@i 1 \fi\fi}
\newcommand\bz@progressdots{%
  \bz@progressvalues
  \ifnum\bz@tot=0 \else
  % section starts that fall inside the deck add a gap of one pitch
  \bz@i=0
  \forlistloop\bz@countgap\bz@secmarks
  \bz@pitch=\dimexpr 56mm/(\bz@tot+\bz@i)\relax
  \ifdim\bz@pitch>1.9mm \bz@pitch=1.9mm \fi
  \bz@gap=\bz@pitch
  \bz@r=0.29\bz@pitch
  \begin{pgfpicture}%
    \pgfsetbaseline{0pt}%
    \pgfsetlinewidth{\bz@hair}%
    \pgfsetstrokecolor{\bz@ink}%
    \pgfsetfillcolor{\bz@ink}%
    \bz@x=0pt \bz@i=0
    \loop\ifnum\bz@i<\bz@tot
      \advance\bz@i 1
      \ifnum\bz@i>1
        \advance\bz@x\bz@pitch
        \xifinlist{\the\bz@i}\bz@secmarks{\advance\bz@x\bz@gap}{}%
      \fi
      \pgfpathcircle{\pgfpoint{\bz@x}{0.5ex}}{\bz@r}%
      \ifnum\bz@i>\bz@cur
        \pgfusepath{stroke}%
      \else
        \pgfusepath{fill}%
      \fi
    \repeat
    % keep the picture's width honest: dots run from -r to x+r
    \pgfpathrectangle{\pgfpoint{-\bz@r}{0pt}}{\pgfpoint{\dimexpr\bz@x+2\bz@r\relax}{0pt}}%
    \pgfusepath{use as bounding box}%
  \end{pgfpicture}%
  \fi}

% right-hand side of the running head
\newcommand\bz@headright{%
  \ifbeamer@inappendix \bz@folio
  \else\ifx\bz@progress\bz@str@dots
    % fixed folio width, so the dots stay put on section pages (no folio)
    \settowidth\bz@foliow{\ifbz@total\insertmainframenumber\,/\,\fi\insertmainframenumber}%
    \bz@progressdots\hskip 2.6mm\hbox to\bz@foliow{\hss\bz@folio}%
  \else
    \bz@folio
  \fi\fi}
\newcommand\bz@headrule{%
  \ifbeamer@inappendix \bz@rule@none
  \else\ifx\bz@progress\bz@str@bar \bz@rule@bar
  \else \bz@rule@none
  \fi\fi}

\newcommand\bz@topline[2]{%
  \vbox to 11mm{%
    \vskip 5.2mm
    \nointerlineskip
    \hbox to\paperwidth{\hskip\bz@margin
      \usebeamercolor[fg]{normal text}\usebeamerfont{bz head}%
      \vphantom{Ag}#1\hfill#2\hskip\bz@margin}%
    \nointerlineskip\vskip 1.5mm
    \hbox to\paperwidth{\hskip\bz@margin\bz@headrule\hss}%
    \vss}}
% \topline{left}{right}: the same running head, placed absolutely.
% Use it on [plain] frames so they share the grid of all other slides.
\newcommand\topline[2]{%
  \begin{textblock*}{\paperwidth}(0mm,0mm)\bz@topline{#1}{#2}\end{textblock*}}

\setbeamertemplate{headline}{%
