%% Statement: one sentence, set large. Pull quote: hanging quotation marks.
\newenvironment{statement}{%
  \par\vspace*{\fill}\begin{minipage}{0.84\linewidth}%
  \usebeamerfont{bz statement}\RaggedRight\bz@nohyph}{%
  \par\end{minipage}\par\vspace*{1.6\fill}}
\newenvironment{pullquote}[1][]{%
  \def\bz@attrib{#1}%
  \par\vspace*{\fill}\begin{minipage}{0.84\linewidth}%
  \usebeamerfont{bz statement}\RaggedRight\bz@nohyph
  \leavevmode\llap{\textquotedblleft}\ignorespaces}{%
  \unskip\textquotedblright\par
  \ifx\bz@attrib\@empty\else
    \vskip 4mm{\usebeamerfont{normal text}\textendash\enspace\bz@attrib\par}%
  \fi
  \end{minipage}\par\vspace*{1.6\fill}}

%% Key figure: one number, always with what it measures and its uncertainty
%%   \keyfigure{43\,\%}{of patients ...}{95\,\% CI 38--48 \textbullet\ n = 312}
\newcommand\keyfigure[3]{%
  \par\vspace*{\fill}%
  {\usebeamerfont{bz keyfigure}\bz@liningnums#1\par}\vskip 3mm
  \begin{minipage}{0.62\linewidth}\RaggedRight\bz@nohyph
    {\usebeamerfont{subtitle}#2\par}\vskip 1.5mm
    {\usebeamerfont{bz head}#3\par}%
  \end{minipage}\par\vspace*{1.6\fill}}

%% Inline inversion for the one word that matters
\newcommand\inv[1]{{\setlength\fboxsep{0.15em}%
  \colorbox{\bz@ink}{\color{\bz@paper}\vphantom{Ågy}#1}}}
\ifbz@italic\ifx\bz@font\bz@str@csf\else\renewcommand\inv[1]{{\itshape #1}}\fi\fi

%% Side-captioned figure: \sidefigure[0.64]{<graphic>}{<caption>}
\newcounter{bzfigure}
\newcommand\sidefigure[3][0.64]{%
  \refstepcounter{bzfigure}%
  \begin{columns}[T,onlytextwidth]
    \begin{column}{#1\textwidth}#2\end{column}%
    \begin{column}{\dimexpr\textwidth-#1\textwidth-6mm\relax}%
      {\usebeamerfont{bz label}Figure~\thebzfigure\par}\vskip 1mm
      {\usebeamerfont{bz caption}\RaggedRight #3\par}%
    \end{column}%
  \end{columns}}

%% Source / reference line at the bottom of a single frame
\newcommand\source[1]{%
  \begin{textblock*}{\dimexpr\paperwidth-2\bz@margin\relax}[0,1](\bz@margin,85mm)%
    % the colour inside its own group, so that its reset stays in the block
    % (textpos moves the block; a reset outside it would leak to later frames)
    \begingroup\usebeamercolor[fg]{normal text}\ifbz@ttype\color{bzgrey}\fi
    \usebeamerfont{bz source}\RaggedRight #1\par\endgroup
  \end{textblock*}}

%% Small label (condensed semibold) for panels, table heads, side notes
\newcommand\smalllabel[1]{{\usebeamerfont{bz label}#1}}

