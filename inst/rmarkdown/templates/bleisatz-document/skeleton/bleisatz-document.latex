% Pandoc template for Bleisatz documents (R package infereportR, MIT license).
% Pandoc's default LaTeX template loads Latin Modern, microtype (with other
% options than the class: an option clash), geometry and its own section
% numbering after the class; this short template leaves type, page layout and
% headings to bleisatz.cls and defines only what pandoc's output needs.
\documentclass$if(classoption)$[$for(classoption)$$classoption$$sep$,$endfor$]$endif${$if(documentclass)$$documentclass$$else$bleisatz$endif$}
\usepackage[$if(babel-lang)$$babel-lang$$else$english$endif$]{babel}
\usepackage{csquotes}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{% scales an image to fit the text height and width
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi}
\def\fps@figure{tbp}
\makeatother
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
$if(tables)$
\usepackage{longtable,array,calc}
$endif$
$if(biblatex)$
\usepackage[backend=biber,style=$if(biblio-style)$$biblio-style$$else$apa$endif$$for(biblatexoptions)$,$biblatexoptions$$endfor$]{biblatex}
$for(bibliography)$
\addbibresource{$bibliography$}
$endfor$
$endif$
$for(header-includes)$
$header-includes$
$endfor$

$if(title)$
\title{$title$}
$endif$
$if(subtitle)$
\subtitle{$subtitle$}
$endif$
$if(shorttitle)$
\shorttitle{$shorttitle$}
$endif$
$if(author)$
\author{$for(author)$$author$$sep$\\$endfor$}
$endif$
$if(institute)$
\institute{$for(institute)$$institute$$sep$\\$endfor$}
$endif$
$if(venue)$
\venue{$for(venue)$$venue$$sep$\\$endfor$}
$endif$
$if(date)$
\date{$date$}
$endif$
$if(correspondence)$
\correspondence{$correspondence$}
$endif$
$if(keywords)$
\keywords{$for(keywords)$$keywords$$sep$, $endfor$}
$endif$

\begin{document}
$if(title)$
\maketitle
$endif$
$if(abstract)$

\begin{abstract}
$abstract$
\end{abstract}
$endif$

$for(include-before)$
$include-before$

$endfor$
$body$

$if(biblatex)$
\printbibliography
$endif$
$for(include-after)$
$include-after$

$endfor$
\end{document}
